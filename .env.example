# required
SESSION_SECRET=change-me-openssl-rand-hex-32
LAPI_URL=http://crowdsec:8080
LAPI_USER=argos
LAPI_PASSWORD=
# create the machine on first start instead of running cscli by hand
LAPI_AUTO_REGISTER=false

# argos talks to docker through argos-docker-proxy (docker-compose.yml): openssl rand -hex 32
DOCKER_PROXY_TOKEN=

# optional
DATA_DIR=/data
INSTANCE_NAME=my-server
CROWDSEC_CONTAINER=crowdsec
# only without the proxy: mount the socket into argos itself and leave DOCKER_PROXY_URL unset
PROM_URL=http://prometheus:9090
TZ=Europe/Berlin

# attack map
HOME_LAT=50.11
HOME_LON=8.68

# never banned by blocklists, comma separated
SELF_IPS=

# cloudflare under attack switch
CF_API_TOKEN=
CF_ZONE_IDS=
# prometheus query returning req/s with a `zone` label
ZONE_RPS_QUERY=

# false only if you serve it over plain http
COOKIE_SECURE=true
# true when a reverse proxy sits in front, so rate limits see the real client ip
TRUST_PROXY=false
