{
  "name": "crowdsec-argos-ui",
  "version": "1.0.0",
  "private": false,
  "description": "Web UI for CrowdSec: live attack map, alerts, bans, blocklists, WAF, hub store, Discord alerts",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test server/test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.7.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.15.30",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.513.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^2.15.3",
    "tailwindcss": "^4.1.10",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "world-atlas": "^2.0.2"
  }
}
